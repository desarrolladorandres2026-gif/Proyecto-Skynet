# Secretos (NUNCA versionar). Rota estas credenciales: ya estuvieron expuestas.
atlas-credentials.env
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Dependencias y builds
**/node_modules
**/dist
/.exe

# Instaladores de la app de escritorio (electron-builder). Binarios de ~90 MB
# por versión: se publican en el VPS (escritorio/npm run publicar), no en Git.
# Se conserva la carpeta para que el empaquetado tenga dónde escribir.
/instalable/*
!/instalable/.gitkeep

# Logs de PM2 en el VPS (ver deploy/ecosystem.config.cjs)
/logs

# Almacenamiento de archivos subidos
Backend/storage

# SO / editor
.DS_Store
Thumbs.db
.idea

# Config local de Claude Code (puede contener datos sensibles de sesión)
.claude/settings.local.json

# Modelo de voz del asistente de escritorio: 40 MB de binarios que no cambian
# entre commits y que Git guardaría para siempre en cada versión.
# Se descarga con:  cd escritorio && npm run modelo
escritorio/recursos/*.tar.gz
