# Plantilla para el .env de DESARROLLO LOCAL. Copia este archivo a .env
# (Backend/.env) en tu máquina y rellena los valores reales.
#
# Diferencia clave con .env.production.example: MONGO_URI debe apuntar a una
# base de datos de DESARROLLO, nunca al cluster/base que usa producción. Si
# no tienes un cluster separado todavía, usa como mínimo un nombre de base de
# datos distinto dentro del mismo cluster gratuito de Atlas (p. ej.
# "Skynet_dev" en vez de "Skynet") para que un seed o una migración corrida
# por error aquí no pueda tocar datos reales — ver también
# Backend/scripts/lib/guardaProduccion.js, que bloquea los scripts
# destructivos si detecta NODE_ENV=production sin confirmación explícita,
# pero esa es una segunda capa de defensa, no la única.
#
# NODE_ENV no se define aquí a propósito: su ausencia hace que env.js caiga
# al default 'development' (ver Backend/src/config/env.js) y NO active las
# validaciones estrictas de URLs de producción (CORS_ORIGIN/FRONTEND_URL/
# API_PUBLIC_URL/FILES_PUBLIC_URL obligatorias y sin localhost).

PORT=3001

# MongoDB — cluster/base de DESARROLLO (nunca el de producción).
MONGO_URI=mongodb+srv://USUARIO_DEV:PASSWORD_DEV@TU-CLUSTER-DEV.mongodb.net/Skynet_dev?retryWrites=true&w=majority

# Auth. Genera un secreto largo y aleatorio (puede ser distinto al de
# producción sin problema, de hecho es preferible):  openssl rand -hex 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# CORS: origen del frontend en desarrollo (Vite). En development, index.js
# además permite automáticamente localhost:5173/4173 aunque esta variable
# esté vacía — ver corsOrigins en Backend/src/index.js.
CORS_ORIGIN=http://localhost:5173

# Email — en desarrollo basta con Gmail + app-password (cae en spam en
# producción, ver docs/notificaciones/README.md, por eso .env.production.example
# recomienda un proveedor transaccional en su lugar).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-cuenta-de-pruebas@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=notificaciones@tudominio.com
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001/api

# Push notifications (VAPID) de DESARROLLO. Genera un par propio con:
#   npx web-push generate-vapid-keys
# NO reutilices las claves VAPID de producción aquí: las suscripciones push
# están atadas a la clave pública, mezclar ambientes las invalidaría o
# generaría confusión sobre a qué dispositivos les llega un push de prueba.
VAPID_EMAIL=mailto:tu-cuenta@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cola de notificaciones (email/push): valores por defecto de env.js ya
# sirven para desarrollo, no hace falta declararlos aquí.

STORAGE_ROOT=./storage
FILES_PUBLIC_URL=http://localhost:3001/storage

# Copiloto (IA), búsqueda web y OAuth de Gmail: opcionales, ver .env.example
# para la explicación completa de cada una y cómo obtenerlas.
GEMINI_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/email/oauth/gmail/callback
TOKEN_ENCRYPTION_KEY=
