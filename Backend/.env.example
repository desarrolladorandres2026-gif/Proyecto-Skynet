# Copia este archivo a .env y rellena los valores REALES.
# NUNCA subas el .env real al repositorio.

PORT=3001

# MongoDB (Atlas). Crea un usuario con permisos mínimos y restringe la IP allowlist.
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/Skynet?retryWrites=true&w=majority

# Auth. Genera un secreto largo y aleatorio:  openssl rand -hex 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# CORS: origen del frontend en producción
CORS_ORIGIN=http://localhost:5173

# Email (reset de contraseña). Usa un app-password, no la contraseña de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-cuenta@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
FRONTEND_URL=http://localhost:5173

# Push notifications (VAPID). Genera con: npx web-push generate-vapid-keys
VAPID_EMAIL=mailto:tu-cuenta@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Almacenamiento de archivos
STORAGE_ROOT=./storage
FILES_PUBLIC_URL=http://localhost:3001/storage
