# Copia este archivo a .env y rellena los valores REALES.
# NUNCA subas el .env real al repositorio.

PORT=3001

# MongoDB (Atlas). Crea un usuario con permisos mínimos y restringe la IP allowlist.
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/Skynet?retryWrites=true&w=majority

# Auth. Genera un secreto largo y aleatorio:  openssl rand -hex 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# CORS: origen del frontend en producción
CORS_ORIGIN=http://localhost:5173

# Email (reset de contraseña). Usa un app-password, no la contraseña de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-cuenta@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
FRONTEND_URL=http://localhost:5173

# Push notifications (VAPID). Genera con: npx web-push generate-vapid-keys
VAPID_EMAIL=mailto:tu-cuenta@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pública del backend (sin barra final). La usa el enlace de baja de
# notificaciones dentro del correo, que se abre sin sesión iniciada.
API_PUBLIC_URL=http://localhost:3001/api

# Cola de notificaciones (email/push): cada cuántos ms revisa pendientes y
# cuántos procesa por lote. Los valores por defecto sirven para desarrollo y
# para el volumen esperado de un ERP interno; ajusta si el volumen crece.
NOTIF_WORKER_INTERVALO_MS=5000
NOTIF_WORKER_LOTE=25

# Almacenamiento de archivos
STORAGE_ROOT=./storage
FILES_PUBLIC_URL=http://localhost:3001/storage

# Copiloto (IA). API key GRATUITA de Google AI Studio (sin tarjeta de
# crédito): https://aistudio.google.com/apikey
# Sin esta variable el módulo "copiloto" puede activarse igual, pero el chat
# responde con un error claro en vez de fallar el arranque del servidor.
GEMINI_API_KEY=
