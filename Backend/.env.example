# Copia este archivo a .env y rellena los valores REALES.
# NUNCA subas el .env real al repositorio.

PORT=3001

# MongoDB (Atlas). Crea un usuario con permisos mínimos y restringe la IP allowlist.
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/Skynet?retryWrites=true&w=majority

# Auth. Genera un secreto largo y aleatorio:  openssl rand -hex 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=8h

# CORS: origen del frontend en producción
CORS_ORIGIN=http://localhost:5173

# Email (reset de contraseña + notificaciones + alertas de conexión).
# Opción A — Gmail (rápido para desarrollo, cae en spam en producción, ver
# docs/notificaciones/README.md): usa un app-password, no la contraseña real.
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_USER=tu-cuenta@gmail.com
#   EMAIL_PASS=xxxx xxxx xxxx xxxx
# Opción B — proveedor transaccional con dominio propio verificado
# (Resend/SES/Postmark/Brevo), recomendado para producción:
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=resend
EMAIL_PASS=<api-key del proveedor>
# Dirección que se ve en "De:". Con Gmail puede quedar igual a EMAIL_USER;
# con un proveedor transaccional debe ser del dominio verificado.
EMAIL_FROM=notificaciones@tudominio.com
FRONTEND_URL=http://localhost:5173

# Push notifications (VAPID). Genera con: npx web-push generate-vapid-keys
VAPID_EMAIL=mailto:tu-cuenta@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pública del backend (sin barra final). La usa el enlace de baja de
# notificaciones dentro del correo, que se abre sin sesión iniciada.
API_PUBLIC_URL=http://localhost:3001/api

# Cola de notificaciones (email/push): cada cuántos ms revisa pendientes y
# cuántos procesa por lote. Los valores por defecto sirven para desarrollo y
# para el volumen esperado de un ERP interno; ajusta si el volumen crece.
NOTIF_WORKER_INTERVALO_MS=5000
NOTIF_WORKER_LOTE=25

# Almacenamiento de archivos
STORAGE_ROOT=./storage
FILES_PUBLIC_URL=http://localhost:3001/storage

# Copiloto (IA). API key GRATUITA de Google AI Studio (sin tarjeta de
# crédito): https://aistudio.google.com/apikey
# Sin esta variable el módulo "copiloto" puede activarse igual, pero el chat
# responde con un error claro en vez de fallar el arranque del servidor.
GEMINI_API_KEY=

# ── Búsqueda web del copiloto (OPCIONAL) ─────────────────────────────────────
# Skynet puede buscar en internet para responder preguntas de actualidad. Sin
# ninguna de estas dos variables la función SIGUE FUNCIONANDO pero en modo
# degradado (DuckDuckGo Instant Answer, sin key): solo resuelve definiciones y
# fichas de entidad, y falla en la mayoría de preguntas de noticias o precios.
#
# Se elige el primero que esté configurado, en este orden:
#
#   1. TAVILY — el mejor para un asistente: devuelve el CONTENIDO de cada
#      página, no solo el fragmento del buscador. 1.000 búsquedas/mes gratis.
#      https://tavily.com
TAVILY_API_KEY=
#   2. BRAVE SEARCH — índice web propio, 2.000 búsquedas/mes gratis.
#      https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ── Módulo Email — conexión OAuth a Gmail (OPCIONAL) ─────────────────────────
# Sin estas variables el módulo "email" sigue activable, pero el botón
# "Conectar" responde un error claro en vez de fallar el arranque.
#
# 1. Ve a https://console.cloud.google.com/ y crea (o reusa) un proyecto.
# 2. Habilita la "Gmail API" (APIs & Services > Library).
# 3. Configura la pantalla de consentimiento OAuth (APIs & Services >
#    OAuth consent screen). Tipo "Internal" si es Google Workspace, o
#    "External" + agregar tu cuenta como "Test user" mientras no esté en
#    producción/verificada por Google.
# 4. Crea credenciales (APIs & Services > Credentials > Create Credentials >
#    OAuth client ID) de tipo "Web application", con este Authorized
#    redirect URI (debe coincidir EXACTO con GOOGLE_REDIRECT_URI de abajo):
#    http://localhost:3001/api/email/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/email/oauth/gmail/callback

# Cifra en Mongo el refresh token de cada cuenta de Gmail conectada. Genera
# con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
