# Plantilla para el .env REAL del VPS de producción (Backend/.env en el
# servidor — deploy/ecosystem.config.cjs fija NODE_ENV=production vía PM2,
# pero sigue siendo dotenv.config() el que carga Backend/.env; no existe hoy
# un mecanismo separado que cargue este archivo por su nombre, así que este
# archivo es una PLANTILLA de referencia para construir el .env real del
# VPS, no un archivo que el código cargue automáticamente).
#
# NUNCA copies este archivo con secretos reales a este repositorio ni a
# ninguna máquina de desarrollo. Vive solo en el VPS.
#
# Con NODE_ENV=production, Backend/src/config/env.js ahora EXIGE que
# CORS_ORIGIN, FRONTEND_URL, API_PUBLIC_URL y FILES_PUBLIC_URL estén
# definidas y que NINGUNA apunte a localhost/127.0.0.1 — el servidor se
# niega a arrancar si no, en vez de arrancar "bien" con enlaces rotos para
# usuarios reales (ver auditoría de producción 2026-08-22).

PORT=3001
NODE_ENV=production

# MongoDB Atlas — cluster/base de PRODUCCIÓN. Usuario con permisos mínimos
# (solo sobre la base "Skynet", no sobre "Skynet_dev") y IP allowlist
# restringida a la IP del VPS.
MONGO_URI=mongodb+srv://USUARIO_PROD:PASSWORD_PROD@TU-CLUSTER-PROD.mongodb.net/Skynet?retryWrites=true&w=majority

# Auth. Genera un secreto largo y aleatorio, DISTINTO al de cualquier
# entorno de desarrollo:  openssl rand -hex 48
JWT_SECRET=

# Dominio real de Skynet (ver deploy/nginx/skynetttn.conf: nginx sirve el
# frontend estático y hace de proxy reverso de /api y /storage bajo el
# MISMO dominio, así que en el camino normal del navegador no hay llamada
# cross-origin real — CORS_ORIGIN queda como defensa explícita igual, para
# cualquier cliente que sí llame cross-origin, y porque env.js ahora la
# exige en producción).
CORS_ORIGIN=https://skynetttn.online
FRONTEND_URL=https://skynetttn.online
API_PUBLIC_URL=https://skynetttn.online/api
FILES_PUBLIC_URL=https://skynetttn.online/storage

# Email — proveedor transaccional con dominio propio verificado
# (Resend/SES/Postmark/Brevo). NO usar una cuenta @gmail.com personal en
# producción: sin SPF/DKIM/DMARC del dominio propio, cae en spam o se
# bloquea (ver docs/notificaciones/README.md). Este es el hallazgo BLOQUEANTE
# de la auditoría 2026-08-22 sobre Backend/.env real: EMAIL_HOST seguía en
# smtp.gmail.com con una cuenta personal.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=resend
EMAIL_PASS=
EMAIL_FROM=notificaciones@skynetttn.online

# Push notifications (VAPID) — las claves reales de producción NO se
# regeneran a la ligera: cambiarlas invalida TODAS las suscripciones push ya
# registradas por los usuarios (ver comentario en Usuario.js/PushSubscription).
VAPID_EMAIL=mailto:contacto@skynetttn.online
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cola de notificaciones: los valores por defecto de env.js (5s / lote de 25)
# sirven para el volumen esperado; ajustar solo si el volumen de usuarios
# crece de forma notable.

STORAGE_ROOT=./storage

# Cloudinary (fotos de reportes de daños, firmas). Credenciales en
# https://console.cloudinary.com > Dashboard > API Keys. No están en
# `required` de env.js (el módulo degrada con error claro sin ellas), pero
# SIN esto la subida de fotos/firmas queda rota en silencio hasta el primer
# intento — no lo dejes vacío en producción real.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Copiloto (IA) — opcional, ver .env.example para el detalle.
GEMINI_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Email — conexión OAuth a Gmail (opcional). El redirect URI debe coincidir
# EXACTO con el configurado en Google Cloud Console para este client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://skynetttn.online/api/email/oauth/gmail/callback

# Cifra en Mongo el refresh token de cada cuenta de Gmail conectada. Genera
# con: openssl rand -hex 32 — DISTINTA a la de cualquier entorno de desarrollo.
TOKEN_ENCRYPTION_KEY=

# ── Backup real (ver scripts/backup/, Fase 13 de la auditoría) ─────────────
# Sin estas variables, scripts/backup/respaldar.js se niega a subir el dump
# a almacenamiento externo (falla con un mensaje claro en vez de fingir que
# subió el archivo). Rellenar solo cuando exista un proveedor S3-compatible
# real (AWS S3, Backblaze B2, Cloudflare R2, etc.) — no inventar valores.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Passphrase simétrica para cifrar el dump antes de subirlo (openssl rand -hex 32).
BACKUP_CIFRADO_CLAVE=

# ── Archivado de auditoría antes de purgar (ver auditoria.worker.js, Fase 12) ─
# Directorio LOCAL de respaldo mientras no haya almacenamiento externo
# configurado (BACKUP_S3_*): auditoria.worker.js exporta ahí antes de
# purgar, y SI ni siquiera este directorio es escribible, no purga nada — no
# hay purga "silenciosa" sin respaldo verificado.
AUDITORIA_ARCHIVO_DIR=./storage/auditoria-archivada
