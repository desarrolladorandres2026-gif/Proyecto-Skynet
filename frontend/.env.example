# En desarrollo, Vite ya hace proxy de /api hacia VITE_BACKEND_URL (ver vite.config.js).
# Solo definí VITE_API_URL si necesitas apuntar el cliente a una URL absoluta distinta
# (por ejemplo, un backend desplegado aparte del frontend en producción).
# VITE_API_URL=https://api.tudominio.com/api

VITE_BACKEND_URL=http://localhost:3001
